  "components" : {
    "schemas" : {
      "PasswordChangeRequest" : {
        "required" : [ "currentPassword", "newPassword" ],
        "type" : "object",
        "properties" : {
          "currentPassword" : {
            "type" : "string",
            "description" : "当前密码，原样校验",
            "format" : "password",
            "writeOnly" : true,
            "example" : "DemoPass_123!"
          },
          "newPassword" : {
            "type" : "string",
            "description" : "至少 8 个 Unicode 码点，UTF-8 最多 72 字节；不改变内容",
            "format" : "password",
            "writeOnly" : true,
            "example" : "NewDemoPass_456!"
          }
        },
        "additionalProperties" : false
      },
      "ApiResponseVoid" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "data" : {
            "type" : "object",
            "nullable" : true
          },
          "traceId" : {
            "type" : "string"
          }
        }
      },
      "RegisterRequest" : {
        "required" : [ "nickname", "password", "username" ],
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string",
            "description" : "去首尾空白、转小写后为 4～32 位字母、数字或下划线",
            "example" : "demo_student_01"
          },
          "password" : {
            "type" : "string",
            "description" : "至少 8 个 Unicode 码点，UTF-8 最多 72 字节；不去空白、不改大小写",
            "format" : "password",
            "writeOnly" : true,
            "example" : "DemoPass_123!"
          },
          "nickname" : {
            "type" : "string",
            "description" : "去首尾空白后为 1～40 个 Unicode 码点",
            "example" : "星海同学"
          }
        },
        "additionalProperties" : false
      },
      "AccountView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "description" : "账号标识，十进制字符串",
            "example" : "101"
          },
          "username" : {
            "type" : "string",
            "example" : "demo_student_01"
          },
          "nickname" : {
            "type" : "string",
            "example" : "星海同学"
          },
          "role" : {
            "type" : "string",
            "example" : "STUDENT",
            "enum" : [ "STUDENT", "MERCHANT", "ADMIN" ]
          },
          "status" : {
            "type" : "string",
            "example" : "ACTIVE",
            "enum" : [ "ACTIVE", "DISABLED" ]
          },
          "version" : {
            "type" : "string",
            "description" : "账号版本；修改昵称时原样回传，不转换为数值",
            "example" : "0"
          }
        }
      },
      "ApiResponseAccountView" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "data" : {
            "$ref" : "#/components/schemas/AccountView"
          },
          "traceId" : {
            "type" : "string"
          }
        }
      },
      "LoginRequest" : {
        "required" : [ "password", "username" ],
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string",
            "description" : "注册时的用户名，去首尾空白并转小写",
            "example" : "demo_student_01"
          },
          "password" : {
            "type" : "string",
            "description" : "原样填写密码，不去空白",
            "format" : "password",
            "writeOnly" : true,
            "example" : "DemoPass_123!"
          }
        },
        "additionalProperties" : false
      },
      "ApiResponseLoginView" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "data" : {
            "$ref" : "#/components/schemas/LoginView"
          },
          "traceId" : {
            "type" : "string"
          }
        }
      },
      "LoginView" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "tokenType" : {
            "type" : "string"
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "account" : {
            "$ref" : "#/components/schemas/AccountView"
          }
        }
      },
      "ProfileUpdateRequest" : {
        "required" : [ "expectedVersion" ],
        "type" : "object",
        "properties" : {
          "nickname" : {
            "type" : "string",
            "description" : "去首尾空白后 1～40 个 Unicode 码点；遗漏不改，null 拒绝",
            "example" : "星海新昵称😀"
          },
          "expectedVersion" : {
            "pattern" : "^(0|[1-9][0-9]{0,18})$",
            "type" : "string",
            "description" : "原样回传 GET /me 的 version 字符串，版本过期返回 409",
            "example" : "0"
          }
        },
        "additionalProperties" : false
      },
      "ApiResponseHealthView" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
